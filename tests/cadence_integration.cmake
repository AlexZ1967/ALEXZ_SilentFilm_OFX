# Эти действия выполняет CTest пользователя, агент их не запускает.
foreach(required HELPER FFMPEG FFPROBE TEST_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing integration argument ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/cadence-${suffix}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${FFMPEG}" -hide_banner -loglevel error -f lavfi
    -i "testsrc2=size=64x48:rate=25:duration=1" -an -c:v ffv1 -pix_fmt yuv444p
    "${root}/source.mkv" RESULT_VARIABLE made ERROR_VARIABLE detail)
if(NOT made EQUAL 0)
    message(FATAL_ERROR "Cannot create CFR fixture: ${detail}")
endif()
execute_process(COMMAND "${HELPER}" --inspect "${root}/source.mkv" RESULT_VARIABLE inspected OUTPUT_VARIABLE metadata)
if(NOT inspected EQUAL 0 OR NOT metadata MATCHES "\"has_alpha\":false")
    message(FATAL_ERROR "Native reader failed to identify opaque input: ${metadata}")
endif()
foreach(format tiff prores)
    set(job "${root}/${format}")
    file(MAKE_DIRECTORY "${job}")
    set(nameSetting "")
    if(format STREQUAL "prores")
        set(nameSetting "output_name=Scene_01_cadence\n")
    endif()
    file(WRITE "${job}/request.ini" "schema=1\n${nameSetting}input=${root}/source.mkv\nformat=${format}\ndevice=cpu\noutput_fps=25\nfps_min=20\nfps_max=20\nvariation=0\nirregularity=0\nmotion_blur=0\nsamples=1\nexposure_link=0\nshake=0\nvignette=0\nedge_softness=0\nsoftness=0\nfocus_drift=0\n")
    execute_process(COMMAND "${HELPER}" --job "${job}/request.ini" RESULT_VARIABLE rendered
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT rendered EQUAL 0)
        message(FATAL_ERROR "${format} export failed: ${output}\n${error}")
    endif()
    file(STRINGS "${job}/result.ini" count REGEX "^frame_count=")
    file(STRINGS "${job}/result.ini" duration REGEX "^output_duration=")
    if(NOT count STREQUAL "frame_count=20")
        message(FATAL_ERROR "Expected 20 physical frames from 25 source frames, got ${count}")
    endif()
    if(NOT duration MATCHES "^output_duration=0\\.8")
        message(FATAL_ERROR "Expected a shorter 0.8-second clip, got ${duration}")
    endif()
    if(format STREQUAL "tiff")
        file(GLOB frames "${job}/frames/frame_*.tif")
        list(LENGTH frames frame_count)
        if(NOT frame_count EQUAL 20 OR NOT EXISTS "${job}/frames/frame_00000000.tif" OR NOT EXISTS "${job}/frames/frame_00000019.tif")
            message(FATAL_ERROR "TIFF physical frame sequence is incomplete")
        endif()
        execute_process(COMMAND "${FFPROBE}" -v error -select_streams v:0 -show_entries stream=pix_fmt
            -of default=noprint_wrappers=1 "${job}/frames/frame_00000000.tif" RESULT_VARIABLE probed OUTPUT_VARIABLE info)
        if(NOT probed EQUAL 0 OR NOT info MATCHES "rgba64le")
            message(FATAL_ERROR "TIFF is not readable RGBA16: ${info}")
        endif()
    else()
        execute_process(COMMAND "${HELPER}" --inspect "${job}/Scene_01_cadence.mov" RESULT_VARIABLE inspected OUTPUT_VARIABLE metadata)
        if(NOT inspected EQUAL 0 OR NOT metadata MATCHES "\"has_alpha\":true")
            message(FATAL_ERROR "Native reader failed to identify ProRes alpha: ${metadata}")
        endif()
        execute_process(COMMAND "${FFPROBE}" -v error -count_frames -select_streams v:0
            -show_entries stream=nb_read_frames,r_frame_rate,codec_name,duration -of default=noprint_wrappers=1
            "${job}/Scene_01_cadence.mov" RESULT_VARIABLE probed OUTPUT_VARIABLE info)
        if(NOT probed EQUAL 0 OR NOT info MATCHES "nb_read_frames=20" OR NOT info MATCHES "r_frame_rate=25/1"
            OR NOT info MATCHES "codec_name=prores" OR NOT info MATCHES "duration=0\\.800000")
            message(FATAL_ERROR "MOV does not contain exactly 20 frames at 25 fps: ${info}")
        endif()
    endif()
endforeach()
# Сохраняем физическое соотношение пикселей в MOV после пересчёта кадров.
execute_process(COMMAND "${FFMPEG}" -hide_banner -loglevel error -f lavfi
    -i "testsrc2=size=64x48:rate=25:duration=1,setsar=4/3" -an -c:v ffv1 -pix_fmt yuv444p
    "${root}/anamorphic.mkv" RESULT_VARIABLE made ERROR_VARIABLE detail)
if(NOT made EQUAL 0)
    message(FATAL_ERROR "Cannot create non-square fixture: ${detail}")
endif()
set(job "${root}/anamorphic")
file(MAKE_DIRECTORY "${job}")
file(WRITE "${job}/request.ini" "schema=1\ninput=${root}/anamorphic.mkv\nformat=prores\ndevice=cpu\noutput_fps=25\nfps_min=20\nfps_max=20\nmotion_blur=0\nshake=0\nedge_softness=0\nsoftness=0\nfocus_drift=0\n")
execute_process(COMMAND "${HELPER}" --job "${job}/request.ini" RESULT_VARIABLE rendered ERROR_VARIABLE error)
if(NOT rendered EQUAL 0)
    message(FATAL_ERROR "Non-square export failed: ${error}")
endif()
execute_process(COMMAND "${FFPROBE}" -v error -select_streams v:0 -show_entries stream=sample_aspect_ratio
    -of default=noprint_wrappers=1 "${job}/cadence.mov" RESULT_VARIABLE probed OUTPUT_VARIABLE info)
if(NOT probed EQUAL 0 OR NOT info MATCHES "sample_aspect_ratio=4:3")
    message(FATAL_ERROR "MOV did not preserve sample aspect ratio: ${info}")
endif()
# Отдельно проверяем In/Out, без пересчёта полной длины файла.
set(job "${root}/trimmed")
file(MAKE_DIRECTORY "${job}")
file(WRITE "${job}/request.ini" "schema=1\ninput=${root}/source.mkv\nformat=tiff\ndevice=cpu\noutput_fps=25\nstart_frame=5\nframe_count=10\nfps_min=20\nfps_max=20\nmotion_blur=0\nshake=0\nedge_softness=0\nsoftness=0\nfocus_drift=0\n")
execute_process(COMMAND "${HELPER}" --job "${job}/request.ini" RESULT_VARIABLE rendered ERROR_VARIABLE error)
if(NOT rendered EQUAL 0)
    message(FATAL_ERROR "Trimmed export failed: ${error}")
endif()
file(STRINGS "${job}/result.ini" count REGEX "^frame_count=")
if(NOT count STREQUAL "frame_count=8")
    message(FATAL_ERROR "Expected 8 physical captures for a marked 0.4-second range: ${count}")
endif()
# Разделённая Camera должна сохранить физическую длину и сразу запечь экспозицию
# в RGB; sidecar для OpenFX не создаётся.
set(job "${root}/split")
file(MAKE_DIRECTORY "${job}")
file(WRITE "${job}/request.ini" "schema=1\nprocessing=capture_rgb\noutput_name=Scene_01_cadence\ninput=${root}/source.mkv\nformat=tiff\ndevice=cpu\noutput_fps=24\nfps_min=20\nfps_max=20\nvariation=0\nirregularity=0\nmotion_blur=0\nshake=0\n")
execute_process(COMMAND "${HELPER}" --job "${job}/request.ini" RESULT_VARIABLE rendered ERROR_VARIABLE error)
if(NOT rendered EQUAL 0)
    message(FATAL_ERROR "Split RGB export failed: ${error}")
endif()
file(STRINGS "${job}/result.ini" count REGEX "^frame_count=")
file(STRINGS "${job}/result.ini" processing REGEX "^processing=")
if(NOT count STREQUAL "frame_count=20" OR NOT processing STREQUAL "processing=capture_rgb"
    OR EXISTS "${job}/camera_optics.sf" OR EXISTS "${job}/camera_optics.sf.tmp")
    message(FATAL_ERROR "Split capture count or manifest-free output is invalid")
endif()
if(NOT EXISTS "${job}/frames/Scene_01_cadence_00000000.tif" OR NOT EXISTS "${job}/frames/Scene_01_cadence_00000019.tif")
    message(FATAL_ERROR "Named TIFF capture sequence is incomplete")
endif()
message(STATUS "Cadence artifacts: ${root}")

# Интерпретация кадров задаётся отдельно от проверки FPS закодированного файла.
set(job "${root}/source-fps")
file(MAKE_DIRECTORY "${job}")
file(WRITE "${job}/request.ini" "schema=1\nprocessing=capture_rgb\ninput=${root}/source.mkv\nformat=tiff\ndevice=cpu\nsource_fps=50\nexpected_source_fps=25\noutput_fps=25\nfps_min=20\nfps_max=20\nmotion_blur=0\nshake=0\n")
execute_process(COMMAND "${HELPER}" --job "${job}/request.ini" RESULT_VARIABLE rendered ERROR_VARIABLE error)
if(NOT rendered EQUAL 0)
    message(FATAL_ERROR "Source FPS interpretation export failed: ${error}")
endif()
file(STRINGS "${job}/result.ini" interpretedCount REGEX "^frame_count=")
if(NOT interpretedCount STREQUAL "frame_count=10")
    message(FATAL_ERROR "source_fps did not change physical capture timing: ${interpretedCount}")
endif()

if(FLOW_AVAILABLE)
    set(job "${root}/flow")
    file(MAKE_DIRECTORY "${job}")
    file(WRITE "${job}/request.ini" "schema=1\nprocessing=capture_rgb\nblur_mode=flow_integrated\ninput=${root}/source.mkv\nformat=tiff\ndevice=cpu\noutput_fps=25\nfps_min=10\nfps_max=30\nvariation=1\nirregularity=0\nmotion_blur=0.8\nsamples=3\nshake=0\n")
    execute_process(COMMAND "${HELPER}" --job "${job}/request.ini" RESULT_VARIABLE rendered ERROR_VARIABLE error)
    if(NOT rendered EQUAL 0)
        message(FATAL_ERROR "Flow exposure export failed: ${error}")
    endif()
    file(STRINGS "${job}/result.ini" flowMode REGEX "^blur_mode=")
    file(STRINGS "${job}/result.ini" flowBackend REGEX "^flow_backend=")
    if(NOT flowMode STREQUAL "blur_mode=flow_integrated" OR NOT flowBackend STREQUAL "flow_backend=opencv_cpu_farneback_warp"
        OR NOT EXISTS "${job}/frames/frame_00000000.tif")
        message(FATAL_ERROR "Flow export silently changed interpolation or did not publish frames")
    endif()
endif()
